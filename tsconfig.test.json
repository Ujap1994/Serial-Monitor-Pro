{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@serialport/bindings-interface": [
        "./node_modules/@serialport/bindings-interface/dist/index.d.ts"
      ],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*",
    "src/shared/**/*",
    "src/main/serial.ts",
    "src/main/simulator.ts",
    "src/main/storage.ts",
    "src/renderer/src/lib/**/*"
  ]
}
